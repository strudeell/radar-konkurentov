# .gitignore радара. Создан ДО git init — это принципиально.
#
# Правило простое: если файл даёт доступ куда-либо от вашего имени или
# восстанавливается запуском скрипта — он не в репозитории.


# ─────────── 1. Секреты. Доступ к аккаунту ВКонтакте ───────────
#
# vk_tokens.json — живой доступ к ВК от лица владельца аккаунта:
# access_token, refresh_token, id_token и user_id. Кто получит файл —
# читает и пишет от вашего имени, пока токен не отозван.
#
# Почему это закрыто до первого коммита, а не после: git хранит историю.
# Файл, попавший хотя бы в один коммит, остаётся в истории навсегда —
# удаление следующим коммитом его оттуда не убирает. Лечится только
# отзывом токена и переписыванием истории.
#
# Сами скрипты vk_token.py и tools/check_vk.py секретов не содержат и
# остаются в репозитории: токен они читают отсюда или из переменной
# окружения VK_TOKEN.

vk_tokens.json
vk_tokens.*.json
*_tokens.json
*.token

# telegram_tokens.json — доступ к боту радара (Фаза 4). Кто получит файл,
# тот пишет в чат владельца от лица бота и читает всё, что боту адресовано.
# Правило и порядок те же, что у ВК: строка появляется здесь ДО того, как
# файл создан, а не после. Сам notify.py и tools/telegram.py секретов не
# содержат — токен читается отсюда или из переменной окружения
# TELEGRAM_BOT_TOKEN. Шаблон без секретов — telegram_tokens.example.json —
# в репозитории остаётся.
telegram_tokens.json
!telegram_tokens.example.json

# Переменные окружения — там же живёт VK_TOKEN.
.env
.env.*
!.env.example

# Секреты никогда не переносятся в config/config.yaml — там только контактный
# ящик и подпись бота. Если однажды появится локальная копия с ключами:
config/config.local.yaml


# ─────────── 2. Воспроизводимый мусор ───────────

__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/


# ─────────── 3. Данные: тяжёлые и восстановимые ───────────
#
# data/_raw/ — 101 сырой HTML конкурентов, 45 МБ. Нужен локально как
# нулевая линия для Фазы 2, но воспроизводится прогоном tools/stage_*.py.
# В репозитории ему делать нечего.
data/_raw/

# Снимки и результаты прогонов лежат в work/. Сами папки версионируем
# (через .gitkeep),
# содержимое — нет. Оно накапливается ежедневно и у каждого своё.
work/snapshots/*
!work/snapshots/.gitkeep
work/runs/*
!work/runs/.gitkeep

# work/diffs/ — найденные изменения (Фаза 3). Правило то же: папка в репозитории,
# содержимое нет. Отличие от снимков одно и оно про диск, а не про git:
# снимки старше 90 дней сборщик удаляет, а диффы не удаляются никогда —
# они весят килобайты, и в них вся история изменений конкурентов.
work/diffs/*
!work/diffs/.gitkeep

# work/logs/ — журналы ежедневных прогонов (Фаза 5). Планировщик показывает
# только код возврата, а что именно случилось — видно здесь. Папка в
# репозитории, содержимое нет: оно локальное, чистится через 90 дней и
# восстановлению не подлежит и не нужно.
work/logs/*
!work/logs/.gitkeep

# work/runs/health.json — память health-check: о какой тревоге владельцу уже
# сказали. Лежит внутри work/runs/, то есть уже закрыт правилом выше; строка
# здесь для того, чтобы это не выглядело случайностью.
work/runs/health.json
work/runs/daily.lock

# work/notify/ — что и когда отправлено человеку (Фаза 4): журнал отправок и
# отчёт по каждому дню. Папка в репозитории, содержимое нет — оно локальное
# и накапливается ежедневно. Журнал не восстановим прогоном, поэтому его
# нельзя чистить: он и есть память о том, о чём человека уже беспокоили.
work/notify/*
!work/notify/.gitkeep

# work/calibration/ — неделя обкатки (Фаза 6): лист разметки и отчёты калибровки.
# Правило то же, что у work/diffs/ и work/notify/: папка в репозитории, содержимое нет.
# Внутри — куски чужих страниц и оценки одного человека, снятые на его данных.
# В репозиторий уходит не это, а вывод недели — он лежит в FAZA-6-OTCHET.md.
work/calibration/*
!work/calibration/.gitkeep

# Результаты разведки Фазы 0 (data/phase0-*.json) НЕ игнорируются:
# это проверенный вход в Фазу 2, секретов в них нет.


# ─────────── 4. Хлам операционной системы и редакторов ───────────

Thumbs.db
desktop.ini
.DS_Store
*.swp
*~
.idea/
.vscode/
